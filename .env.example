# Copy this file to .env to change the defaults. No API keys are needed.

# Ollama server that runs the local language models (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# Chat and report-analysis model. Use an instruct (non-thinking) model for fast replies.
OLLAMA_MODEL=qwen3:4b-instruct

# Vision model that reads photos and scanned PDFs
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct

# Context window in tokens (optional). Larger fits longer reports but needs more memory.
# OLLAMA_NUM_CTX=8192

# How long Ollama keeps the chat model loaded after a request (optional)
# OLLAMA_KEEP_ALIVE=30m

# How long to keep the vision model loaded after reading a document (optional).
# 0 frees its memory straight away; raise it if you have RAM to spare and upload many images.
# OLLAMA_VISION_KEEP_ALIVE=0

# Database connection string (optional, defaults to SQLite at database/backend.db)
# DATABASE_URL=sqlite:////absolute/path/to/backend.db

# How long a login lasts, in days (optional)
# AUTH_TOKEN_DAYS=7

# Comma-separated list of allowed CORS origins (optional, defaults to *)
# CORS_ORIGINS=http://localhost:3000

# Log level (optional, defaults to INFO)
# LOG_LEVEL=INFO
