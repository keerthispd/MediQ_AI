# Copy this file to .env to change the defaults. The app runs fully locally with no API keys; the
# hosted fallback at the bottom is optional and always asks the user before it is used.

# Ollama server that runs the local language models (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# Report-analysis model. Bigger and slower, but better at reasoning, which is what reading values
# against reference ranges needs. Use an instruct (non-thinking) model: thinking models spend
# their whole output budget reasoning and are far slower.
OLLAMA_MODEL=qwen3:4b-instruct

# Everyday chat model. Smaller and roughly twice as fast, which matters on a CPU-only machine.
# Uploaded reports still go to OLLAMA_MODEL above.
OLLAMA_FAST_MODEL=qwen2.5:1.5b-instruct

# Model for messages the red-flag detector marks as a possible emergency (optional). Defaults to
# OLLAMA_MODEL: the advice that has to be right is fixed text rather than generated (see
# backend/services/redflag.py) and reaches the screen in milliseconds either way, so what the model
# writes underneath it is background - and measured on a CPU, the 1.5B model got that background
# wrong often enough to be worth 20 more seconds of the 4B one. Set this to OLLAMA_FAST_MODEL for a
# ~7s reply instead of ~25s, on a machine that cannot keep both models resident (about 5.3 GB).
# Under Docker, a model named here also has to be added to the ollama service's pull command in
# docker-compose.yml.
# OLLAMA_EMERGENCY_MODEL=qwen2.5:1.5b-instruct

# Model for a lone symptom that is usually ordinary - "I have trouble breathing" (optional).
# These are answered with the possible causes in order, commonest first, and a question or two,
# and putting them in order is something the small model measurably does not do: it copies the
# retrieved page's list out in the page's own order. Defaults to OLLAMA_EMERGENCY_MODEL. Set it to
# OLLAMA_FAST_MODEL to halve the wait on the commonest kind of question and accept that ordering.
# A model named here must be installed, and pulled in docker-compose.yml under Docker.
# OLLAMA_CAUTION_MODEL=qwen2.5:1.5b-instruct

# Vision model that reads photos and scanned PDFs
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct

# Context window in tokens (optional). Larger fits longer reports but needs more memory.
# OLLAMA_NUM_CTX=8192

# How long Ollama keeps the chat model loaded after a request (optional). Once it lapses the next
# message pays for the model to load again, which adds about 20 seconds; -1 keeps it loaded for good.
# OLLAMA_KEEP_ALIVE=30m

# CPU threads for inference (optional). 0 lets Ollama choose, which was as fast as any value tried
# on the machine this was measured on. Worth experimenting with only if replies feel slow.
# OLLAMA_NUM_THREAD=0

# Load the chat models when the server starts, so the first message doesn't wait for them
# (optional). The emergency model is loaded first. Set to 0 to disable.
# OLLAMA_WARMUP=1

# How long to keep the vision model loaded after reading a document (optional).
# 0 frees its memory straight away; raise it if you have RAM to spare and upload many images.
# OLLAMA_VISION_KEEP_ALIVE=0

# Database connection string (optional, defaults to SQLite at database/backend.db)
# DATABASE_URL=sqlite:////absolute/path/to/backend.db

# How long a login lasts, in days (optional)
# AUTH_TOKEN_DAYS=7

# Comma-separated list of allowed CORS origins (optional, defaults to *)
# CORS_ORIGINS=http://localhost:3000

# Log level (optional, defaults to INFO)
# LOG_LEVEL=INFO

# ----------------------------------------------------------------------------------------------
# Optional hosted fallback, for when the local model cannot be used.
#
# PRIVACY: everything above runs on this machine. Configuring a provider here does NOT switch the
# app over to it. If the local model fails, the app explains the situation and asks the user; only
# if they accept is their message (and any uploaded report) sent to that provider over the
# internet, where it is handled under that provider's privacy policy. Leave these unset to keep
# the app entirely offline.
#
# Pick one with CLOUD_PROVIDER, or leave it blank and whichever API key is set will be used.
# CLOUD_PROVIDER=anthropic

# Anthropic Claude. Needs: pip install anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# Re-runs a request another model declined, which medical wording can trigger. Set to 0 to disable.
# ANTHROPIC_REFUSAL_FALLBACK=1

# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Output cap for hosted replies (optional). Higher than the local cap because hosted models are
# fast, so the risk is a truncated answer rather than a slow one.
# CLOUD_MAX_TOKENS=2048
